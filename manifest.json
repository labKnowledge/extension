{
  "manifest_version": 3,
  "name": "QuietView",
  "description": "Hide distracting page elements on any site. Pick, paste, or rule — your layout stays quiet.",
  "version": "1.0.1",
  "author": "Eligapris",
  "homepage_url": "https://eligapris.com/quietview",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuietView",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "start-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Start QuietView element picker"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quietview@eligapris.com",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["utils/constants.js", "utils/selector.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
