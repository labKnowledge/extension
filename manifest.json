{
  "manifest_version": 3,
  "name": "QuietView: Hide Elements & Focus Mode",
  "description": "Hide distractions, focus any element full screen, or redact sensitive info for screenshots. Saved per site. Private.",
  "version": "1.2.0",
  "author": "Eligapris",
  "homepage_url": "https://eligapris.com/quietview",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "utils/constants.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuietView",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "start-picker": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      },
      "description": "Hide an element (click it on the page)"
    },
    "focus-element": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Focus on an element (make it fill the screen)"
    },
    "redact-mode": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Redact: blur or black out sensitive info, then screenshot"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "quietview@eligapris.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils/constants.js",
        "utils/selector.js",
        "utils/hider.js",
        "utils/focus.js",
        "utils/recipes.js",
        "utils/redact.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "QuietView"
}
